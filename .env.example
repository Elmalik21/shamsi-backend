SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# Railway PostgreSQL Database Connection
# Copy this file to .env and replace with your actual credentials.
# Use the PUBLIC proxy URL from Railway Dashboard → PostgreSQL → Connect tab.
# Do NOT use postgres.railway.internal — that only works inside Railway's network.
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@YOUR_HOST.proxy.rlwy.net:PORT/railway

CORS_ALLOWED_ORIGINS=http://localhost:5173
DJANGO_SETTINGS_MODULE=shamsi_smart.settings
